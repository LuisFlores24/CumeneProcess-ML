<?xml version="1.0" encoding="utf-8"?>
<Library xmlns:info="http://SimSci.Com/NextGenSim/Schema2.0.0/Informational" xmlns="http://SimSci.Com/NextGenSim/Schema2.0.0">
<Name>C:\Users\ASUS\My Libraries\CumenePFRLib.libx</Name>
<info:SoftwareVersion>7.3</info:SoftwareVersion>
<Version>7.3</Version>
    <Model>
      <Type>CumenePFRAveva</Type>
<Description>Replaceable RxnModelType model for CSTR, PFR, and EQR reactor models and Column. Designed for use with CmnGas fluid.(1) 1 BENZENE + 1 PROPENE = 1 CUMENE</Description>
      <NamePrefix>R</NamePrefix>
      <NameStartingNumber>1</NameStartingNumber>
      <IsReplaceableModel />
      <Parameters>
        <Parameter>
          <Name>FluidType</Name>
          <Type>FluidType</Type>
          <Default>Process.DefFluid</Default>
        </Parameter>
        <Parameter>
          <Name>Nrxn</Name>
          <Description>Rates number of individual reactions</Description>
          <Type>Integer</Type>
        <Default>1</Default>
          <Max>100</Max>
          <Min>1</Min>
        </Parameter>
        <Parameter>
          <Name>R</Name>
          <Description>Gas constant</Description>
          <Type>Molar Entropy</Type>
          <Default>8.314</Default>
        </Parameter>
      </Parameters>
      <Connections>
      </Connections>
      <Variables>
        <Variable>
          <Name>P</Name>
          <Description>CumenePFRAveva pressure</Description>
          <Type>Pressure</Type>
          <UplevelReference />
          <Min>FluidType.PMin</Min>
          <Max>FluidType.PMax</Max>
          <Default>FluidType.Pressure</Default>
        </Variable>
        <Variable>
          <Name>T</Name>
          <Description>CumenePFRAveva temperature</Description>
          <Type>Temperature</Type>
          <Min>FluidType.TMin</Min>
          <Max>FluidType.TMax</Max>
          <Default>FluidType.Temperature</Default>
        </Variable>
        <Variable>
          <Name>z</Name>
          <Description>CumenePFRAveva molar bulk phase composition</Description>
          <Type>Molar Composition</Type>
          <Dimension>FluidType.CompList</Dimension>
          <Default>FluidType.Composition</Default>
        </Variable>
        <Variable>
          <Name>C</Name>
          <Description>CumenePFRAveva molar bulk phase concentration</Description>
          <Type>Molar Concentration</Type>
        </Variable>
        <Variable>
          <Name>RateRxn</Name>
          <Description>CumenePFRAveva reaction rate of the individual reactions' base component</Description>
          <Type>Mole Flow</Type>
          <Dimension>Nrxn</Dimension>
          <Min>0</Min>
          <Max>0</Max>
        </Variable>
        <Variable>
          <Name>Reaction</Name>
          <Description>CumenePFRAveva reaction factor</Description>
          <Type>Fraction</Type>
        </Variable>
        <Variable>
          <Name>Heat</Name>
          <Description>CumenePFRAveva heat adjustment (normally zero as enthalpies include heat of formation)</Description>
          <Type>Heat Duty</Type>
          <ProcessMode />
          <FluidFlowMode />
          <DynamicMode />
        </Variable>
        <Variable>
          <Name>Rate</Name>
          <Description>CumenePFRAveva component reaction rates</Description>
          <Type>Reaction Rate per Weight</Type>
          <Dimension>FluidType.CompList</Dimension>
          <Min>0</Min>
          <Max>0</Max>
        </Variable>
        <Variable>
          <Name>k</Name>
          <Description>CumenePFRAveva rate constant of each reaction</Description>
          <Type>Dimensionless</Type>
          <Dimension>NRxn</Dimension>
        </Variable>
        <Variable>
          <Name>Cy</Name>
          <Description>CumenePFRAveva molar concentration of each component in vapor phase</Description>
          <Type>Molar Concentration</Type>
          <Dimension>FluidType.CompList</Dimension>
          <Default>FluidType.Composition</Default>
        </Variable>
      </Variables>
      <Equations>
        <Equation>
          <Name>Eqn_Cy</Name>
          <Formula>Cy = StateX.Vv^(-1) * StateX.y</Formula>
        </Equation>
        <Equation>
          <Name>Rate_BENZENE</Name>
          <Formula>Rate["BENZENE"] = (-1) * RateRxn[1] </Formula>
        </Equation>
        <Equation>
          <Name>Rate_PROPENE</Name>
          <Formula>Rate["PROPENE"] = (-1) * RateRxn[1] </Formula>
        </Equation>
        <Equation>
          <Name>Rate_CUMENE</Name>
          <Formula>Rate["CUMENE"] = (1) * RateRxn[1] </Formula>
        </Equation>
        <Equation>
          <Name>Rate_Inerts</Name>
          <Description>Inert components not participating in reactions</Description>
          <Formula>Rate[not{"BENZENE", "PROPENE", "CUMENE"}] = 0</Formula>
        </Equation>
        <Equation>
          <Name>k_Rxn1</Name>
          <Formula>k[1] = 35000 * exp(-24901 * 4.184 / (R * T))</Formula>
        </Equation>
        <Equation>
          <Name>Rate_Rxn1</Name>
          <Formula>RateRxn[1] = k[1] * Cy["PROPENE"] * Cy["BENZENE"]</Formula>
        </Equation>
      </Equations>
      <Models>
        <Model>
          <Name>StateX</Name>
          <ModelTypeParameter>FluidType.StateModel</ModelTypeParameter>
        </Model>
      </Models>
      <GraphicData>
        <Icon>
          <DefaultIcon>Default</DefaultIcon>
          <Images>
            <Image>
              <Name>Default</Name>
              <Rendering>
                <Drawing Format="xaml">&lt;Viewbox xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Stretch="Fill"&gt;
  &lt;Canvas Width="100" Height="100"&gt;
    &lt;Path StrokeThickness="5" Stroke="Black" Data="M 50,3 a 47,47 0 0 0 0,94 a 47,47 0 0 0 0,-94"&gt;
      &lt;Path.Fill&gt;
        &lt;RadialGradientBrush  GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="1" RadiusY="1" &gt;
          &lt;GradientStop Color="White" Offset="0.0" /&gt;
          &lt;GradientStop Color="#ff707070" Offset="1.0" /&gt;
        &lt;/RadialGradientBrush&gt;
      &lt;/Path.Fill&gt;
    &lt;/Path&gt;
    &lt;TextBlock  Width="60" Height="60" Canvas.Left="30" Canvas.Top="15" FontFamily="Arial" FontSize="58" FontStyle="normal" FontWeight="SemiBold" Foreground="Black" TextWrapping="Wrap"&gt;RM&lt;/TextBlock&gt;
  &lt;/Canvas&gt;
&lt;/Viewbox&gt;</Drawing>
              </Rendering>
            </Image>
          </Images>
        </Icon>
      </GraphicData>
      <Help>
        <Content format="rtfzip"><![CDATA[]]></Content>
      </Help>
    </Model>

</Library>